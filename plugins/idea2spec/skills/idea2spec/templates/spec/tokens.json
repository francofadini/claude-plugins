{
  "$description": "Design tokens in W3C Design Tokens (DTCG) format: every token has $value and $type. Generate src/theme/tokens.ts from this file (Style Dictionary or a small script); never hardcode a value in a component. Values below are neutral iOS defaults: replace them with the project's approved brand (canon §11). Units: points (pt) as plain numbers, durations in ms. Custom $type values (not in the DTCG spec): spring (duration + dampingRatio) and haptic (expo-haptics call).",
  "color": {
    "light": {
      "bg":        { "$type": "color", "$value": "#FFFFFF", "$description": "systemBackground: screens" },
      "bgGrouped": { "$type": "color", "$value": "#F2F2F7", "$description": "systemGroupedBackground: grouped lists" },
      "surface":   { "$type": "color", "$value": "#FFFFFF", "$description": "cells and cards on grouped background" },
      "ink":       { "$type": "color", "$value": "#000000", "$description": "primary text" },
      "ink2":      { "$type": "color", "$value": "#3C3C4399", "$description": "secondary text (60%)" },
      "ink3":      { "$type": "color", "$value": "#3C3C434D", "$description": "tertiary text, placeholders, disabled only" },
      "separator": { "$type": "color", "$value": "#3C3C432E" },
      "fill":      { "$type": "color", "$value": "#78788029", "$description": "tracks, fields, secondary buttons" },
      "accent":    { "$type": "color", "$value": "#0088FF", "$description": "the ONLY accent: primary action, selected tab, links" },
      "onAccent":  { "$type": "color", "$value": "#FFFFFF" },
      "state": {
        "ok":      { "$type": "color", "$value": "#34C759" },
        "warn":    { "$type": "color", "$value": "#FF8D28" },
        "danger":  { "$type": "color", "$value": "#FF383C", "$description": "destructive actions and errors only" }
      }
    },
    "dark": {
      "bg":        { "$type": "color", "$value": "#000000" },
      "bgGrouped": { "$type": "color", "$value": "#000000" },
      "surface":   { "$type": "color", "$value": "#1C1C1E" },
      "ink":       { "$type": "color", "$value": "#FFFFFF" },
      "ink2":      { "$type": "color", "$value": "#EBEBF599" },
      "ink3":      { "$type": "color", "$value": "#EBEBF54D" },
      "separator": { "$type": "color", "$value": "#54545899" },
      "fill":      { "$type": "color", "$value": "#7676803D" },
      "accent":    { "$type": "color", "$value": "#0091FF" },
      "onAccent":  { "$type": "color", "$value": "#FFFFFF" },
      "state": {
        "ok":      { "$type": "color", "$value": "#30D158" },
        "warn":    { "$type": "color", "$value": "#FF9230" },
        "danger":  { "$type": "color", "$value": "#FF4245" }
      }
    }
  },
  "font": {
    "family": {
      "text":    { "$type": "fontFamily", "$value": "System", "$description": "SF Pro via the system font; data and controls" },
      "display": { "$type": "fontFamily", "$value": "System", "$description": "large titles and the brand voice; a brand may set a custom family here" }
    }
  },
  "type": {
    "largeTitle":  { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": 34, "lineHeight": 41, "fontWeight": 700, "letterSpacing": 0.4 } },
    "title2":      { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 22, "lineHeight": 28, "fontWeight": 700, "letterSpacing": -0.26 } },
    "headline":    { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 17, "lineHeight": 22, "fontWeight": 600, "letterSpacing": -0.43 } },
    "body":        { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 17, "lineHeight": 22, "fontWeight": 400, "letterSpacing": -0.43 } },
    "rowTitle":    { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 17, "lineHeight": 22, "fontWeight": 500, "letterSpacing": -0.43 } },
    "rowSubtitle": { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 15, "lineHeight": 20, "fontWeight": 400, "letterSpacing": -0.23 } },
    "footnote":    { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 13, "lineHeight": 18, "fontWeight": 400, "letterSpacing": -0.08 } },
    "caption":     { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 12, "lineHeight": 16, "fontWeight": 600, "letterSpacing": 1.2, "textTransform": "uppercase" } }
  },
  "space": {
    "inGroup":     { "$type": "dimension", "$value": 12, "$description": "between rows / elements of one group" },
    "betweenGroups": { "$type": "dimension", "$value": 44, "$description": ">= 3x inGroup" },
    "betweenZones":  { "$type": "dimension", "$value": 64 },
    "margin":      { "$type": "dimension", "$value": 20, "$description": "screen side margin" },
    "marginTight": { "$type": "dimension", "$value": 16, "$description": "side margin in dense or on-the-move screens" },
    "row":         { "$type": "dimension", "$value": 52, "$description": "minimum row height" },
    "rowTall":     { "$type": "dimension", "$value": 68, "$description": "row with a 56 pt image" },
    "touch":       { "$type": "dimension", "$value": 44, "$description": "minimum touch target" }
  },
  "radius": {
    "thumb":   { "$type": "dimension", "$value": 8 },
    "field":   { "$type": "dimension", "$value": 12 },
    "card":    { "$type": "dimension", "$value": 26, "$description": "inset grouped lists and cards" },
    "capsule": { "$type": "dimension", "$value": 999, "$description": "everything tappable that is not a row" }
  },
  "size": {
    "thumb":       { "$type": "dimension", "$value": 56 },
    "primaryButton": { "$type": "dimension", "$value": 50 },
    "smallButton": { "$type": "dimension", "$value": 34 }
  },
  "motion": {
    "$description": "Springs without bounce, interruptible, inheriting the finger's velocity. Map to Reanimated withSpring({ duration, dampingRatio }). System chrome (sheets, tabs, navigation) keeps the system animation: never animate it yourself.",
    "spring": {
      "standard": { "$type": "spring", "$value": { "duration": 450, "dampingRatio": 1 }, "$description": "content settling, panels" },
      "quick":    { "$type": "spring", "$value": { "duration": 300, "dampingRatio": 1 }, "$description": "small elements, toggles, checkmarks" },
      "flung":    { "$type": "spring", "$value": { "duration": 500, "dampingRatio": 0.85 }, "$description": "only when the finger flung it" }
    },
    "fade": {
      "reduceMotion": { "$type": "duration", "$value": 150, "$description": "with Reduce Motion on, movements become fades of this length" }
    }
  },
  "haptic": {
    "$description": "Haptics answer what the PERSON did. What the app does by itself does not vibrate. Map to expo-haptics.",
    "select":  { "$type": "haptic", "$value": "ImpactFeedbackStyle.Rigid",  "$description": "mark, add, choose" },
    "settle":  { "$type": "haptic", "$value": "ImpactFeedbackStyle.Soft",   "$description": "something lands in place" },
    "drag":    { "$type": "haptic", "$value": "selectionAsync",              "$description": "each step while dragging or scrubbing" },
    "success": { "$type": "haptic", "$value": "NotificationFeedbackType.Success", "$description": "finishing something long" },
    "error":   { "$type": "haptic", "$value": "NotificationFeedbackType.Error",   "$description": "the person's action failed" }
  }
}
